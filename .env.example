# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Analytics only loads when this is set, so local/dev builds stay clean.
NEXT_PUBLIC_GA_ID=

# Contact form → Notion pipeline.
# 1. Create an internal integration at notion.so/profile/integrations
# 2. Share the "Website Inquiries" database with it
# 3. Paste the secret + the database ID here (and in Vercel env settings).
# The form returns a friendly "email us instead" message until these are set.
NOTION_API_KEY=
NOTION_INQUIRIES_DB_ID=

# Careers → Notion pipeline (same integration/token as the contact form).
# Recommended: the original "Available Job Positions" board that powered the
# legacy site — share it with the integration and set:
#   NOTION_JOBS_DB_ID=5d1bdd35676d4c7aaa78d0e29a17dcde
# (The newer "Job Vacancies" database also works; both schemas are handled.)
# Rows with Status = Open are shown, refreshed hourly; unset = static fallback.
#
# Each open role also gets a /careers/<slug> page rendering the JD from the
# Notion page body. Optional: add an "Apply URL" column to the board and the
# apply buttons point there (a form, a mailto); without it they fall back to
# /contact?intent=careers. Only rows with Status = Open are ever published.
NOTION_JOBS_DB_ID=

# Publish a Notion jobs edit immediately instead of waiting out the 30-minute
# refresh. Generate a secret (`openssl rand -hex 32`), set it here and in
# Vercel, then bookmark:
#   https://corplabs.co/api/revalidate?secret=THE_SECRET
# Opening that URL clears the jobs cache; the careers pages rebuild from Notion
# on the next visit. Nothing is deleted and no deploy is triggered. Treat the
# URL as a password: anyone holding it can force refreshes (and only that).
# Unset = the endpoint returns 503 and the normal 30-minute refresh applies.
REVALIDATE_SECRET=

# Keystatic blog admin (/keystatic) — GitHub mode.
# Editors sign in with GitHub and each save is a commit to this repo, so the
# admin works on the deployed site. One-time setup, run LOCALLY (GitHub App
# creation is dev-only by design):
#   1. npm run dev, open http://localhost:3000/keystatic
#   2. Follow the setup wizard — enter https://www.corplabs.co as the deployed
#      URL so the production callback is registered alongside localhost
#   3. GitHub redirects back and writes the three secrets below into .env
#   4. Copy all four values into Vercel → Settings → Environment Variables
#   5. Install the new GitHub App on corplabs-co/corplabs-frontend
# Only people with write access to the repo can publish.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
